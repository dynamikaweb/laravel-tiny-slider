{
    "name": "dynamikasolucoesweb/laravel-tiny-slider",
    "description": "Um componente Blade robusto e flexível para integração do Tiny Slider em aplicações Laravel.",
    "type": "library",
    "keywords": ["dynamika", "laravel", "tiny-slider"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Giordani da Silveira dos Santos",
            "email": "giordani@dynamika.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "DynamikaSolucoesWeb\\TinySlider\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DynamikaSolucoesWeb\\TinySlider\\TinySliderServiceProvider"
            ]
        }
    }
}